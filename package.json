{
  "name": "financeguard-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-first finance app — Clean Architecture (Domain/Application/Infrastructure/Presentation)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "sync:android": "npm run build && npx cap sync android",
    "prod:android": "npm run build && npx cap sync android",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^6.1.2",
    "@hookform/resolvers": "^5.4.3",
    "@tanstack/react-query": "^5.101.4",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "dropbox": "^10.36.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^2.13.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
